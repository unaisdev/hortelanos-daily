{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hortelanos Daily",
  "version": "1.1.1",
  "identifier": "dev.unais.hortelanos-daily",
  "build": {
    "frontendDist": "../desktop-www",
    "devUrl": "http://127.0.0.1:8787/shell/",
    "beforeDevCommand": "node scripts/serve.mjs 8787",
    "beforeBuildCommand": "node scripts/prepare-desktop-www.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hortelano's Daily",
        "width": 980,
        "height": 740,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Launcher de play-daily",
    "longDescription": "Hortelano's Daily \u2014 intro retro y men\u00fa para Daily Gold, Daily Red y futuros play-daily.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": null
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": ""
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../shell": "shell",
      "../runner": "runner",
      "../catalog": "catalog",
      "../games": "games",
      "../index.html": "index.html",
      "../docs": "docs"
    }
  },
  "plugins": {}
}
