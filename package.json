{
  "name": "hortelanos-daily",
  "version": "2.5.3",
  "private": true,
  "description": "Hortelano's Daily \u2014 launcher de play-daily (Gold, Red, \u2026)",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "tauri": "tauri",
    "prepare:desktop-www": "node scripts/prepare-desktop-www.mjs",
    "desktop:dev": "tauri dev --config src-tauri/tauri.debug.conf.json",
    "desktop:build": "tauri build",
    "desktop:build:debug": "tauri build --debug --config src-tauri/tauri.debug.conf.json",
    "verify": "scripts/verify-protocol.sh games/dailygold && scripts/verify-protocol.sh games/dailyred && scripts/verify-protocol.sh games/dailysteven",
    "test:protocols": "node scripts/test-protocols.mjs",
    "test:stats": "node scripts/test-daily-stats.mjs",
    "test:ranking-seed": "node scripts/test-ranking-seed.mjs",
    "test:streaks": "node scripts/test-streaks.mjs",
    "test:ranking-cache": "node --test scripts/test-ranking-cache.mjs",
    "test:steven": "node --test scripts/test-steven-archive.mjs scripts/test-ranking-availability.mjs services/ranking-api/test/ranking.test.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "npm run test:stats && npm run test:protocols && npm run test:ranking-seed && npm run test:streaks && npm run test:ranking-cache && npm run test:rust && npm run verify"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.4"
  }
}
